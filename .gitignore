# ============================================================
# MAA-PRTS · 只提交代码与资源包
# 用户数据（token、账号练度、配置、日志）一律不入库
# ============================================================

# 用户数据：设置、账号练度（token 密文随账号文件）、迁移产物，一律不入库
config/*
# 旧旧版数据目录（升级后首次启动会自动并入 config/；锚定根目录，
# 不锚定的话会连任意位置的 skland/ 一起排除）
/skland/

# 运行日志（可随手删）
debug/*

# 打包产物（整个目录不入库）
build/*
dist/
*.spec

# 程序自更新：下载的安装包与解压暂存（一次十几 MB，不入库）
/update/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 临时截图
shot-*.png

# 资源包更新前的自动备份（更新资源数据.bat 生成）
resources/*.bak

# 发布打包临时目录（只锚定根目录，别误伤 tools/release 模板）
/release/
